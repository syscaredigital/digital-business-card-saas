FRONTEND_URL=http://127.0.0.1:5500
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v2/rates?base=LKR
EXCHANGE_RATE_CACHE_MS=21600000
PUBLIC_APP_URL=https://syncecard.com
PUBLIC_VCARD_PATH=/pages/public-vcard/profile.html

# Private Email SMTP (use the mailbox password for info@syncecard.lk)
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USER=info@syncecard.lk
MAIL_PASS=replace-with-smtp-password
MAIL_FROM="Sync E-Card <info@syncecard.lk>"

# Enable only after SMTP validation; Passenger deployments should use a cron worker instead.
NOTIFICATION_JOBS=false
