APP_DOMAIN=syncecard.lk
PUBLIC_APP_URL=https://syncecard.lk
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
APP_TIMEZONE=Asia/Colombo
DB_NAME=cards
DB_USER=cards
DB_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=replace-with-the-same-database-password
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM="Sync E-Card <info@syncecard.lk>"
# Supply only while creating the first administrator; remove afterwards.
# SUPER_ADMIN_EMAIL=admin@your-domain.com
# SUPER_ADMIN_PASSWORD=unique-password-at-least-12-characters
