APP_DOMAIN=syncecard.com
PUBLIC_APP_URL=https://syncecard.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
APP_TIMEZONE=Asia/Colombo
DB_NAME=cards
DB_USER=cards
DB_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=cards
POSTGRES_USER=cards
POSTGRES_PASSWORD=replace-with-the-same-database-password
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USER=info@syncecard.lk
MAIL_PASS=your-smtp-password
MAIL_FROM="Sync E-Card <info@syncecard.lk>"
# Supply only while creating the first administrator; remove afterwards.
# SUPER_ADMIN_EMAIL=admin@your-domain.com
# SUPER_ADMIN_PASSWORD=unique-password-at-least-12-characters

# Enable only after SMTP validation; Passenger deployments should use a cron worker instead.
NOTIFICATION_JOBS=false
