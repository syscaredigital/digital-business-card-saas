# Add these variables in cPanel > Setup Node.js App > Environment variables.
# Alternatively save a private copy as backend/.env (never in frontend).
NODE_ENV=production
PUBLIC_APP_URL=https://test.syncecard.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
APP_TIMEZONE=Asia/Colombo
DB_HOST=replace-with-postgresql-host
DB_PORT=5432
DB_NAME=replace-with-postgresql-database
DB_USER=replace-with-postgresql-user
DB_PASSWORD=replace-with-postgresql-password
# Use true for a remote provider requiring TLS; use its trusted CA if needed.
DB_SSL=true
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USER=replace-with-smtp-user
MAIL_PASS=replace-with-smtp-password
MAIL_FROM="Sync E-Card <info@syncecard.lk>"
# Keep a sender address that your SMTP provider has authorized.
# Do not copy Docker's DB_HOST=db or TRUST_PROXY address into cPanel.

# Enable only after SMTP validation; Passenger deployments should use a cron worker instead.
NOTIFICATION_JOBS=false
